{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "NestJS Debug",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "protocol": "inspector",
      "sourceMapPathOverride": {
        "/Users/jin/Desktop/main/safety-edu/safe-education-backend/dist/*": "/Users/jin/Desktop/main/safety-edu/safe-education-backend/src/*"
      }
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach NestJS Debugger",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"],
      "protocol": "inspector"
    }
  ]
}
