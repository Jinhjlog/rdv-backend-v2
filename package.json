{
  "name": "rdv-backend-v2",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:local": "cross-env NODE_ENV=local nest start --watch",
    "start:debug": "cross-env NODE_ENV=local nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:docker": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_ENV=test node scripts/run-e2e.js",
    "test:scenarios": "cross-env NODE_ENV=test node scripts/run-scenario.js",
    "prisma:seed:local": "cross-env NODE_ENV=local node scripts/run-seed.js",
    "prisma:seed:prod": "cross-env NODE_ENV=production node scripts/run-seed.js",
    "prisma:generate:local": "dotenv -e .env.local -- prisma generate",
    "prisma:generate:prod": "dotenv -e .env.production -- prisma generate",
    "prisma:pull:local": "node scripts/pre-pull.js && dotenv -e .env.local -- prisma db pull && node scripts/fix-schema.js",
    "prisma:pull:prod": "node scripts/pre-pull.js && dotenv -e .env.production -- prisma db pull && node scripts/fix-schema.js",
    "prisma:sync:local": "npm run prisma:pull:local && npm run prisma:generate:local",
    "supabase:diff": "npx supabase db diff --schema public",
    "supabase:push": "npx supabase db push",
    "db:dump:prod": "mkdir -p dumps && dotenv -e .env.production -- sh -c 'npx supabase db dump --db-url \"$DATABASE_URL\" --data-only > dumps/production_data_$(date +%Y%m%d_%H%M%S).sql'",
    "db:restore:local": "sh -c 'LATEST_DUMP=$(ls -t dumps/production_data_*.sql 2>/dev/null | head -n1); if [ -z \"$LATEST_DUMP\" ]; then echo \"Error: No dump file found in dumps/\"; exit 1; fi; echo \"Restoring from: $LATEST_DUMP\"; docker exec -i supabase_db_rdv-backend-v2 psql -U postgres -d postgres < \"$LATEST_DUMP\"'"
  },
  "dependencies": {
    "@google-cloud/tasks": "^6.2.1",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.17.1",
    "@supabase/supabase-js": "^2.80.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.0.0",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@testcontainers/postgresql": "^12.0.0",
    "@testcontainers/redis": "^12.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.17.1",
    "source-map-support": "^0.5.21",
    "supabase": "^2.101.0",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/module/core/$1",
      "^@lib/(.*)$": "<rootDir>/lib/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ]
  }
}
