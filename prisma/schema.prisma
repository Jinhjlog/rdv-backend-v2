  arrived_at  DateTime?          @db.Timestamptz(6)
  events      events             @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "event_participant_event_id_fkey")
  users       public_users       @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "event_participant_user_id_fkey")

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
